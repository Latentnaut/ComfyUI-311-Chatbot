# ComfyUI-Chatbot-311 Configuration Template
# Copy this file to '.env' and fill in your Gemini API Key.

# Google Gemini API key (starts with AIzaSy)
GEMINI_API_KEY=your_api_key_here

# Model to use (e.g., gemini-3.8-flash, gemini-3.7-flash, gemini-3.5-flash-lite or gemini-3.1-pro-preview)
GEMINI_MODEL=gemini-3.8-flash
